{
  "name": "keyforce-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:client": "pnpm --filter client dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:battle": "pnpm --filter battle start",
    "build:client": "pnpm --filter client build",
    "build:api": "pnpm --filter api build",
    "build:battle": "pnpm --filter battle build"
  }
} 